<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nueva recolección" android:textSize="16sp" android:textColor="#193B29" android:layout_marginTop="10dp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Trabajador" android:textSize="16sp" android:textColor="#193B29" android:layout_marginTop="10dp" /><EditText android:id="@+id/txtTrabajador" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="Nombre del trabajador" android:inputType="textPersonName" android:maxLength="80"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Área de recolección" android:textSize="16sp" android:textColor="#193B29" android:layout_marginTop="10dp" /><EditText android:id="@+id/txtArea" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="Ejemplo: almacén" android:inputType="textCapSentences" android:maxLength="80"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fecha de recolección" android:textSize="16sp" android:textColor="#193B29" android:layout_marginTop="10dp" /><EditText android:id="@+id/txtFecha" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="Selecciona la fecha" android:inputType="none" android:focusable="false" android:clickable="true"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tipo de residuo" android:textSize="16sp" android:textColor="#193B29" android:layout_marginTop="10dp" /><Spinner android:id="@+id/spTipo" android:layout_width="match_parent" android:layout_height="48dp" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Peso medido en kilogramos" android:textSize="16sp" android:textColor="#193B29" android:layout_marginTop="10dp" /><EditText android:id="@+id/txtPeso" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="Ejemplo: 2.5" android:inputType="numberDecimal" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Volumen medido en litros" android:textSize="16sp" android:textColor="#193B29" android:layout_marginTop="10dp" /><EditText android:id="@+id/txtVolumen" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="Ejemplo: 10" android:inputType="numberDecimal" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Observación opcional" android:textSize="16sp" android:textColor="#193B29" android:layout_marginTop="10dp" /><EditText android:id="@+id/txtObservacion" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="Detalle de la recolección" android:inputType="textMultiLine" android:maxLength="300"/><Button android:id="@+id/btnGuardar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Guardar registro" android:textAllCaps="false" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No mezcles residuos para pesarlos. Sigue el procedimiento de seguridad de la empresa." android:textSize="16sp" android:textColor="#193B29" android:layout_marginTop="10dp" /></LinearLayout></ScrollView>
